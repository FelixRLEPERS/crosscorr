\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Scale-dependent WSPR spot reduction: binned residual analysis for the 20\,m band (18-month training period). Spot residuals (relative to monthly-hourly-daily baseline) are shown as a function of $Kp$ bin. The monotonic gradient from quiet ($Kp<3$) to storm ($Kp\ge 5$) confirms the scale-dependent response.}}{8}{figure.caption.5}\protected@file@percent }
\newlabel{fig:scale}{{2}{8}{Scale-dependent WSPR spot reduction: binned residual analysis for the 20\,m band (18-month training period). Spot residuals (relative to monthly-hourly-daily baseline) are shown as a function of $Kp$ bin. The monotonic gradient from quiet ($Kp<3$) to storm ($Kp\ge 5$) confirms the scale-dependent response}{figure.caption.5}{}}
